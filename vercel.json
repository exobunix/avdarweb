{
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/avdar-innovations/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://avdarweb.onrender.com/api/:path*"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
